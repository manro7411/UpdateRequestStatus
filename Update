	final boolean isCompletedAndClosed =rpServicesConstant.NDID_REQUEST_STATUS_COMPLETED.equalsIgnoreCase(req.getStatus())&& req.isClosed();
							final boolean isPartialComplete =rpServicesConstant.NDID_REQUEST_STATUS_PARTIAL_COMPLETED.equalsIgnoreCase(req.getStatus());
							final boolean hasIncomingData =req.getDataList() != null&& !req.getDataList().isEmpty();
							if ((isCompletedAndClosed || isPartialComplete) && hasIncomingData) {
							    try {
							        boolean isYourData = false;
							        if (req.getData_request_list() != null) {
							            for (DataRequest dataRequest : req.getData_request_list()) {
							                String serviceId = dataRequest.getService_id();
							                if (serviceId != null&& serviceId.startsWith(rpServicesConstant.PRECONSENT_PREFIX)) {
							                    isYourData = true;
							                    break;
							                }
							            }
							        }

							        List<DataList> previousDataList = null;
							        final String previousHistoryGuid =ndidRPTrans.getGuidTransHistTransData();
							        if (ValidationInput.validateField(previousHistoryGuid)) {
							            final NdidTransactionHistoryEMB historyEMB =new NdidTransactionHistoryEMB();
							            final NdidTransactionHistory previousHistory =historyEMB.findNdidTransactionHistoryByGUID(previousHistoryGuid);
							            if (previousHistory != null&& ValidationInput.validateField(previousHistory.getRequesterReqPayload())) {
							                final RequestStatusTO previousRequest =(RequestStatusTO) jsonHelper.convJSONToObj(previousHistory.getRequesterReqPayload(),RequestStatusTO.class,true);
							                if (previousRequest != null) {
							                    previousDataList = previousRequest.getDataList();
							                }
							            }
							        }
							        for (DataList currentData : req.getDataList()) {
							            boolean exists = false;
							            if (previousDataList != null&& !previousDataList.isEmpty()) {
							                for (DataList previousData : previousDataList) {
							                    if (currentData.getService_id().equalsIgnoreCase(previousData.getService_id())&& currentData.getSource_node_id().equalsIgnoreCase(previousData.getSource_node_id())) {
							                        exists = true;
							                        break;
							                    }
							                }
							            }
							            if (exists) {
							            	logging.setLogDebug("Skip duplicate data. serviceId"+currentData.getService_id()+"sourceNodeId="+currentData.getSource_node_id());
							                continue;
							            }
							            YourDataResponse currentResponse =(YourDataResponse) jsonHelper.convJSONToObj(currentData.getData(),YourDataResponse.class,true);

							            if (currentResponse == null|| currentResponse.getSubIdentityList() == null|| currentResponse.getSubIdentityList().isEmpty()) {
							                continue;
							            }
							            ConsentInsertRequest consentRequest =new ConsentInsertRequest();
							            consentRequest.setRequestId(req.getRequest_id());
							            consentRequest.setServiceId(currentData.getService_id());
							            consentRequest.setSourceType(SourceType.DC);
							            consentRequest.setSubIdentities(currentResponse.getSubIdentityList());
							            consentRequest.setTokenJwt(currentResponse.getAuthorization());
							            boolean saved =savePreConsentTokens(httpReq, consentRequest);
							            if (!saved) {
//							                isSuccess = false;
//							                logger.error("Failed to save pre-consent token. serviceId={}, sourceNodeId={}",currentData.getService_id(),currentData.getSource_node_id());
							                break;
							            }
							        }

							    } catch (Exception e) {
//							    	isSuccess = false;
							        logging.setLoggerInfo(e.getMessage(),e.getStackTrace(),functionName);
							    }
							}


